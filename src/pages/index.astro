				"text": "Argon Chat is a voice chat built for gamers: clean voice, real multiplayer games right inside the call, an overlay that shows who's talking over your game, and coins and levels just for hanging out — all in one app."
			}
		},
		{
			"@type": "Question",
			"name": "Is Argon Chat free?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Yes. Voice, messaging, screen sharing and communities are all free. An optional subscription, Ultima, adds extras like animated avatars, bigger uploads, higher-quality audio and video, custom themes and space boosts."
			}
		},
		{
			"@type": "Question",
			"name": "What platforms does Argon support?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Argon Chat is a desktop app for Windows, macOS, and Linux, and it updates itself. Mobile is in development."
			}
		}
	]
})} />

<script>
	// Register the isolated client-shell replica web component (<argon-client-mock>).
	import '../components/argon-mock/argon-client-mock.ts';

	const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%&*';

	// ── Text scramble effect on hero title ──
	function initScramble() {
		const words = document.querySelectorAll<HTMLElement>('.hero-word');
		words.forEach((el, i) => {
			const target = el.dataset.word || el.textContent || '';
			el.textContent = '';
			const delay = 600 + i * 400;

			setTimeout(() => {
				let iteration = 0;
				const maxIterations = target.length * 3;
				const interval = setInterval(() => {
					el.textContent = target
						.split('')
						.map((char, idx) => {
							if (idx < iteration / 3) return char;
							return CHARS[Math.floor(Math.random() * CHARS.length)];
						})
						.join('');
					iteration++;
					if (iteration > maxIterations) {
						clearInterval(interval);
						el.textContent = target;
					}
				}, 30);
			}, delay);
		});
	}


	// ── Particle canvas (subtle floating dots) ──
	function initParticles() {
		const canvas = document.getElementById('hero-particles') as HTMLCanvasElement;
		if (!canvas) return;
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		let w = 0, h = 0;
		let mouseX = -1000, mouseY = -1000;

		function resize() {
			const section = canvas.parentElement;
			if (!section) return;
			w = section.offsetWidth;
			h = section.offsetHeight;
			canvas.width = w;
			canvas.height = h;
		}
		resize();
		window.addEventListener('resize', resize);

		const particles: { x: number; y: number; vx: number; vy: number; r: number; a: number }[] = [];
		const count = Math.min(60, Math.floor(w * h / 15000));

		for (let i = 0; i < count; i++) {
			particles.push({
				x: Math.random() * w,
				y: Math.random() * h,
				vx: (Math.random() - 0.5) * 0.3,
				vy: (Math.random() - 0.5) * 0.3,
				r: Math.random() * 1.5 + 0.5,
				a: Math.random() * 0.3 + 0.05
			});
		}

		canvas.parentElement?.addEventListener('mousemove', (e) => {
			const rect = canvas.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
		});

		canvas.parentElement?.addEventListener('mouseleave', () => {
			mouseX = -1000;
			mouseY = -1000;
		});

		function draw() {
			ctx!.clearRect(0, 0, w, h);
			const isDark = document.documentElement.classList.contains('dark');
			const color = isDark ? '255,255,255' : '0,0,0';

			for (const p of particles) {
				// Repel from cursor
				const dx = p.x - mouseX;
				const dy = p.y - mouseY;
				const dist = Math.sqrt(dx * dx + dy * dy);
				if (dist < 120) {
					const force = (120 - dist) / 120 * 0.8;
					p.vx += (dx / dist) * force;
					p.vy += (dy / dist) * force;
				}

				p.vx *= 0.98;
				p.vy *= 0.98;
				p.x += p.vx;
				p.y += p.vy;

				if (p.x < 0) p.x = w;
				if (p.x > w) p.x = 0;
				if (p.y < 0) p.y = h;
				if (p.y > h) p.y = 0;

				ctx!.beginPath();
				ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
				ctx!.fillStyle = `rgba(${color},${p.a})`;
				ctx!.fill();
			}

			// Draw connections
			for (let i = 0; i < particles.length; i++) {
				for (let j = i + 1; j < particles.length; j++) {
					const dx = particles[i].x - particles[j].x;
					const dy = particles[i].y - particles[j].y;
					const dist = Math.sqrt(dx * dx + dy * dy);
					if (dist < 100) {
						ctx!.beginPath();
						ctx!.moveTo(particles[i].x, particles[i].y);
						ctx!.lineTo(particles[j].x, particles[j].y);
						ctx!.strokeStyle = `rgba(${color},${(1 - dist / 100) * 0.06})`;
						ctx!.stroke();
					}
				}
			}

			requestAnimationFrame(draw);
		}
		draw();
	}

	// ── Feature card tilt on hover ──
	function initCardTilt() {
		document.querySelectorAll<HTMLElement>('.feature-card').forEach(card => {
			card.addEventListener('mousemove', (e) => {
				const rect = card.getBoundingClientRect();
				const x = (e.clientX - rect.left) / rect.width - 0.5;
				const y = (e.clientY - rect.top) / rect.height - 0.5;
				card.style.transform = `perspective(600px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg) scale(1.02)`;
			});
			card.addEventListener('mouseleave', () => {
				card.style.transform = '';
			});
		});
	}

	// ── Konami code easter egg ──
	function initKonami() {
		const code = [38,38,40,40,37,39,37,39,66,65];
		let pos = 0;
		document.addEventListener('keydown', (e) => {
			if (e.keyCode === code[pos]) {
				pos++;
				if (pos === code.length) {
					pos = 0;
					document.body.classList.add('konami-active');
					setTimeout(() => document.body.classList.remove('konami-active'), 4000);
				}
			} else {
				pos = 0;
			}
		});
	}


	// ── Enrollment modal ──
	const TURNSTILE_SITE_KEY = '0x4AAAAAAA0DPoxKcBNZt4vC';
	let captchaToken: string | null = null;

	function initEnrollModal() {
		const modal = document.getElementById('enroll-modal');
		const closeBtn = document.getElementById('enroll-modal-close');
		const form = document.getElementById('enroll-form') as HTMLFormElement | null;
		const emailInput = document.getElementById('enroll-email') as HTMLInputElement | null;
		const errorEl = document.getElementById('enroll-error');
		const submitBtn = document.getElementById('enroll-submit') as HTMLButtonElement | null;
		const btnText = document.getElementById('enroll-btn-text');
		const btnArrow = document.getElementById('enroll-btn-arrow');
		const btnSpinner = document.getElementById('enroll-btn-spinner');
		const formWrap = document.getElementById('enroll-form-wrap');
		const successWrap = document.getElementById('enroll-success');
		if (!modal) return;

		// Open modal triggers
		document.querySelectorAll('[data-open-enroll]').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.preventDefault();
				modal.classList.remove('hidden');
				modal.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
				emailInput?.focus();
				loadTurnstile();
			});
		});

		// Close
		function close() {
			modal.classList.add('hidden');
			modal.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
		}

		closeBtn?.addEventListener('click', close);
		modal.querySelector('.enroll-modal-backdrop')?.addEventListener('click', close);
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
		});

		// Load Turnstile
		function loadTurnstile() {
			if (document.getElementById('turnstile-script')) return;
			const script = document.createElement('script');
			script.id = 'turnstile-script';
			script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
			script.async = true;
			script.onload = () => {
				if (typeof (window as any).turnstile !== 'undefined') {
					(window as any).turnstile.render('#turnstile-container', {
						sitekey: TURNSTILE_SITE_KEY,
						callback: (token: string) => { captchaToken = token; },
						theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light',
					});
				}
			};
			document.body.appendChild(script);
		}

		// Submit
		form?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const email = emailInput?.value.trim() || '';
			if (!email || !email.includes('@')) {
				if (errorEl) { errorEl.textContent = 'Please enter a valid email address.'; errorEl.classList.remove('hidden'); }
				return;
			}

			const consent = document.getElementById('enroll-consent') as HTMLInputElement | null;
			if (!consent?.checked) {
				if (errorEl) { errorEl.textContent = 'Please accept the Terms and consent to data processing to continue.'; errorEl.classList.remove('hidden'); }
				return;
			}

			errorEl?.classList.add('hidden');
			if (submitBtn) submitBtn.disabled = true;
			if (btnText) btnText.textContent = 'Submitting...';
			btnArrow?.classList.add('hidden');
			btnSpinner?.classList.remove('hidden');

			try {
				const res = await fetch('https://enroll.argon.gl', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email, turnstile: captchaToken }),
				});

				if (res.status === 451) {
					if (errorEl) { errorEl.textContent = 'Your region is not supported for enrollment.'; errorEl.classList.remove('hidden'); }
					return;
				}
				if (!res.ok) throw new Error('fail');

				formWrap?.classList.add('hidden');
				successWrap?.classList.remove('hidden');
				setTimeout(close, 5000);
			} catch {
				if (errorEl) { errorEl.textContent = 'Failed to submit. Please try again later.'; errorEl.classList.remove('hidden'); }
			} finally {
				if (submitBtn) submitBtn.disabled = false;
				if (btnText) btnText.textContent = 'Request Invite';
				btnArrow?.classList.remove('hidden');
				btnSpinner?.classList.add('hidden');
			}
		});
	}

	// ── Confetti on download clicks ──
	function initConfetti() {
		import('canvas-confetti').then(({ default: confetti }) => {
			document.querySelectorAll('.confetti-trigger').forEach(btn => {
				btn.addEventListener('click', (e) => {
					const rect = (btn as HTMLElement).getBoundingClientRect();
					const x = (rect.left + rect.width / 2) / window.innerWidth;
					const y = (rect.top + rect.height / 2) / window.innerHeight;

					// Side cannons
					confetti({ particleCount: 60, angle: 60, spread: 55, origin: { x: 0, y: 0.65 }, colors: ['#8b5cf6', '#06b6d4', '#c084fc', '#a78bfa', '#22d3ee'] });
					confetti({ particleCount: 60, angle: 120, spread: 55, origin: { x: 1, y: 0.65 }, colors: ['#8b5cf6', '#06b6d4', '#c084fc', '#a78bfa', '#22d3ee'] });

					// From button
					confetti({ particleCount: 30, spread: 70, origin: { x, y }, colors: ['#8b5cf6', '#06b6d4', '#c084fc', '#fbbf24', '#34d399'] });
				});
			});
		});
	}

	// Init all
	initScramble();
	initParticles();
	initCardTilt();
	initKonami();
	initEnrollModal();
	initConfetti();

	// Auto-open enrollment if ?enroll=1 or #enroll
	if (new URLSearchParams(window.location.search).has('enroll') || window.location.hash === '#enroll') {
		const modal = document.getElementById('enroll-modal');
		if (modal) {
			modal.classList.remove('hidden');
			modal.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
		}
	}
</script>
