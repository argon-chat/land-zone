		}
	]
})} />

<script>
	// Register the isolated client-shell replica web component (<argon-client-mock>).
	import '../components/argon-mock/argon-client-mock.ts';

	const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%&*';

	// ── Text scramble effect on hero title ──
	function initScramble() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const words = document.querySelectorAll<HTMLElement>('.hero-word');
		words.forEach((el, i) => {
			const target = el.dataset.word || el.textContent || '';
			el.textContent = '';
			const delay = 600 + i * 400;

			setTimeout(() => {
				let iteration = 0;
				const maxIterations = target.length * 3;
				const interval = setInterval(() => {
					el.textContent = target
						.split('')
						.map((char, idx) => {
							if (idx < iteration / 3) return char;
							return CHARS[Math.floor(Math.random() * CHARS.length)];
						})
						.join('');
					iteration++;
					if (iteration > maxIterations) {
						clearInterval(interval);
						el.textContent = target;
					}
				}, 30);
			}, delay);
		});
	}


	// ── Particle canvas (subtle floating dots) ──
	function initParticles() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const canvas = document.getElementById('hero-particles') as HTMLCanvasElement;
		if (!canvas) return;
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		let w = 0, h = 0;
		let mouseX = -1000, mouseY = -1000;
		let running = false;
		let frame = 0;

		function resize() {
			const section = canvas.parentElement;
			if (!section) return;
			w = section.offsetWidth;
			h = section.offsetHeight;
			canvas.width = w;
			canvas.height = h;
		}
		resize();
		window.addEventListener('resize', resize);

		const particles: { x: number; y: number; vx: number; vy: number; r: number; a: number }[] = [];
		const count = Math.min(60, Math.floor(w * h / 15000));

		for (let i = 0; i < count; i++) {
			particles.push({
				x: Math.random() * w,
				y: Math.random() * h,
				vx: (Math.random() - 0.5) * 0.3,
				vy: (Math.random() - 0.5) * 0.3,
				r: Math.random() * 1.5 + 0.5,
				a: Math.random() * 0.3 + 0.05
			});
		}

		canvas.parentElement?.addEventListener('mousemove', (e) => {
			const rect = canvas.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
		});

		canvas.parentElement?.addEventListener('mouseleave', () => {
			mouseX = -1000;
			mouseY = -1000;
		});

		function draw() {
			if (!running) return;
			ctx!.clearRect(0, 0, w, h);
			const isDark = document.documentElement.classList.contains('dark');
			const color = isDark ? '255,255,255' : '0,0,0';

			for (const p of particles) {
				// Repel from cursor
				const dx = p.x - mouseX;
				const dy = p.y - mouseY;
				const dist = Math.sqrt(dx * dx + dy * dy);
				if (dist < 120) {
					const force = (120 - dist) / 120 * 0.8;
					p.vx += (dx / dist) * force;
					p.vy += (dy / dist) * force;
				}

				p.vx *= 0.98;
				p.vy *= 0.98;
				p.x += p.vx;
				p.y += p.vy;

				if (p.x < 0) p.x = w;
				if (p.x > w) p.x = 0;
				if (p.y < 0) p.y = h;
				if (p.y > h) p.y = 0;

				ctx!.beginPath();
				ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
				ctx!.fillStyle = `rgba(${color},${p.a})`;
				ctx!.fill();
			}

			// Draw connections
			for (let i = 0; i < particles.length; i++) {
				for (let j = i + 1; j < particles.length; j++) {
					const dx = particles[i].x - particles[j].x;
					const dy = particles[i].y - particles[j].y;
					const dist = Math.sqrt(dx * dx + dy * dy);
					if (dist < 100) {
						ctx!.beginPath();
						ctx!.moveTo(particles[i].x, particles[i].y);
						ctx!.lineTo(particles[j].x, particles[j].y);
						ctx!.strokeStyle = `rgba(${color},${(1 - dist / 100) * 0.06})`;
						ctx!.stroke();
					}
				}
			}

			frame = requestAnimationFrame(draw);
		}

		// The hero is one viewport tall, so this loop spent most of a session
		// drawing something nobody could see. It now runs only while on screen.
		const observer = new IntersectionObserver(([entry]) => {
			if (entry.isIntersecting && !running) {
				running = true;
				draw();
			} else if (!entry.isIntersecting && running) {
				running = false;
				cancelAnimationFrame(frame);
			}
		}, { threshold: 0 });
		observer.observe(canvas.parentElement || canvas);
	}

	// ── Feature card tilt on hover ──
	function initCardTilt() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		if (!window.matchMedia('(pointer: fine)').matches) return;

		document.querySelectorAll<HTMLElement>('.feature-card').forEach(card => {
			let rect: DOMRect | null = null;
			let queued = false;
			let px = 0, py = 0;

			card.addEventListener('mouseenter', () => { rect = card.getBoundingClientRect(); });
			card.addEventListener('mousemove', (e) => {
				if (!rect) rect = card.getBoundingClientRect();
				px = (e.clientX - rect.left) / rect.width - 0.5;
				py = (e.clientY - rect.top) / rect.height - 0.5;
				if (queued) return;
				queued = true;
				requestAnimationFrame(() => {
					queued = false;
					card.style.transform = `perspective(600px) rotateY(${px * 8}deg) rotateX(${-py * 8}deg) translateY(-2px) scale(1.02)`;
				});
			});
			card.addEventListener('mouseleave', () => {
				rect = null;
				card.style.transform = '';
			});
		});
	}

	// ── Confetti on download clicks ──
	function initConfetti() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		import('canvas-confetti').then(({ default: confetti }) => {
			document.querySelectorAll('.confetti-trigger').forEach(btn => {
				btn.addEventListener('click', (e) => {
					const href = (btn as HTMLAnchorElement).href;
					const rect = (btn as HTMLElement).getBoundingClientRect();
					const x = (rect.left + rect.width / 2) / window.innerWidth;
					const y = (rect.top + rect.height / 2) / window.innerHeight;

					// Side cannons
					confetti({ particleCount: 60, angle: 60, spread: 55, origin: { x: 0, y: 0.65 }, colors: ['#8b5cf6', '#06b6d4', '#c084fc', '#a78bfa', '#22d3ee'] });
					confetti({ particleCount: 60, angle: 120, spread: 55, origin: { x: 1, y: 0.65 }, colors: ['#8b5cf6', '#06b6d4', '#c084fc', '#a78bfa', '#22d3ee'] });

					// From button
					confetti({ particleCount: 30, spread: 70, origin: { x, y }, colors: ['#8b5cf6', '#06b6d4', '#c084fc', '#fbbf24', '#34d399'] });

					// Same-tick navigation would unmount the canvas before a single
					// frame painted. Hold briefly, then follow the link.
					if (href) {
						e.preventDefault();
						setTimeout(() => { window.location.href = href; }, 450);
					}
				});
			});
		});
	}

	// Init all
	initScramble();
	initParticles();
	initCardTilt();
	initConfetti();
</script>
