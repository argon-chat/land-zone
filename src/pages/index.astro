			"name": "Is Argon Chat free?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Yes. Voice, messaging, screen sharing and communities are all free. An optional subscription, Ultima, adds extras like animated avatars, bigger uploads, higher-quality audio and video, custom themes and space boosts."
			}
		},
		{
			"@type": "Question",
			"name": "What platforms does Argon support?",
			"acceptedAnswer": {
				"@type": "Answer",
