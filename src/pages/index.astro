---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CoinRain from '../components/CoinRain.vue';
import {
  Users, Shield, Monitor, Lock, Zap, ArrowRight,
  Download, Volume2, Sparkles, Heart, Crown, Trophy, Gift, Star
} from 'lucide-astro';
---

<Layout
	title="Argon Chat — Voice, Games & Community, Built for Gamers"
	description="The voice chat where your squad actually plays together. Clean voice, real games right inside the call, and an overlay that keeps you in the loop without leaving your game. Free to start — Windows, macOS, Linux."
>
	<Navbar current="/" />

	<!-- ═══════════════════════════════════════════════ -->
	<!-- HERO                                           -->
	<!-- ═══════════════════════════════════════════════ -->
	<section id="main-content" class="relative min-h-[100vh] overflow-hidden flex flex-col">
		<!-- Background -->
		<div class="absolute inset-0 hero-bg-gradient"></div>
		<canvas id="hero-particles" class="absolute inset-0 pointer-events-none z-[1]"></canvas>

		<!-- Hero heading + CTA -->
		<div class="relative z-10 pt-40 sm:pt-48 md:pt-56 pb-10 sm:pb-14 px-4 sm:px-6 text-center">
			<h1 class="hero-title text-4xl font-black leading-[1.05] tracking-tight sm:text-5xl md:text-6xl lg:text-7xl" id="hero-scramble">
				<span class="hero-word" data-word="Drop in.">Drop in.</span>
				<span class="hero-word" data-word="Talk.">Talk.</span>
				<span class="hero-word hero-gradient" data-word="Play.">Play.</span>
			</h1>
			<p class="animate-fade-in-up-delay-1 mx-auto mt-6 max-w-lg text-sm sm:text-base md:text-lg leading-relaxed text-text-secondary">
				Crystal-clear voice. Real games right inside the call. Loot just for showing up.<br class="hidden sm:block" />
				The hangout your squad's been looking for.
			</p>
			<div class="animate-fade-in-up-delay-2 mt-8 flex flex-wrap items-center justify-center gap-3">
				<button type="button" class="hero-cta-primary group confetti-trigger" data-open-enroll>
					<Download class="size-4" />
					Request Invite
					<span class="hero-cta-shine"></span>
				</button>
			</div>
		</div>

		<!-- Bottom: live app preview — faithful, isolated <argon-client-mock> replica -->
		<div class="relative z-10 flex-1 flex items-end justify-center px-2 sm:px-6 pb-0">
			<div class="hero-mock animate-fade-in-up-delay-2">
				<argon-client-mock></argon-client-mock>
			</div>
		</div>

		<!-- Fade out at bottom -->
		<div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-oled-black to-transparent z-20 pointer-events-none"></div>
	</section>


	<!-- ═══════════════════════════════════════════════ -->
	<!-- SECTION: PlayFrame — Games (lead with the wow) -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="py-24 sm:py-32 px-4 sm:px-6 relative overflow-hidden">
		<div class="mx-auto max-w-6xl">
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
				<div class="reveal">
					<div class="flex items-center gap-2 mb-3">
						<span class="section-label">PlayFrame</span>
						<span class="text-[9px] font-bold uppercase tracking-wider bg-accent/10 text-accent px-2 py-0.5 rounded-full border border-accent/20">No installs</span>
					</div>
					<h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight">
						Games inside<br/>your calls
					</h2>
					<p class="text-text-secondary mt-4 text-base sm:text-lg leading-relaxed max-w-lg">
						Queue dropped you? Waiting on a lobby? Don't go hunting for something to do — PlayFrame drops real multiplayer games straight into your voice channel. No installs, no downloads, nobody leaves the call. Loser shares their screen.
					</p>

					<div class="mt-6 space-y-3">
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-3/10 text-[10px] font-bold text-accent-3">⚡</span>
							<span class="text-sm text-text-secondary">One click and you're in — everyone playing in seconds</span>
						</div>
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-3/10 text-[10px] font-bold text-accent-3">⚡</span>
							<span class="text-sm text-text-secondary">Games can't touch your account, your chats, or your files</span>
						</div>
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-3/10 text-[10px] font-bold text-accent-3">⚡</span>
							<span class="text-sm text-text-secondary">Fresh games dropping all the time</span>
						</div>
					</div>
				</div>

				<!-- PlayFrame mockup -->
				<div class="reveal reveal-delay-2 flex justify-center w-full">
					<argon-client-mock view="playframe"></argon-client-mock>
				</div>
			</div>
		</div>
	</section>


	<!-- ═══════════════════════════════════════════════ -->
	<!-- SECTION: Crystal Clear Voice (+ overlay)       -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="py-24 sm:py-32 px-4 sm:px-6 bg-oled-surface/30">
		<div class="mx-auto max-w-6xl">
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
				<!-- Voice channel mockup -->
				<div class="reveal reveal-delay-2 order-2 lg:order-1 flex justify-center w-full">
					<argon-client-mock view="voice"></argon-client-mock>
				</div>

				<div class="reveal order-1 lg:order-2">
					<span class="section-label">Voice-First</span>
					<h2 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight">
						Crystal clear,<br/>every time
					</h2>
					<p class="text-text-secondary mt-4 text-base sm:text-lg leading-relaxed max-w-lg">
						Your mechanical keyboard. The fan. Someone yelling downstairs. Gone. Your squad hears you — not your room.
						And it's quick enough that callouts land the second you make them.
					</p>

					<div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3">
						<div class="glass rounded-xl p-4 feature-card">
							<Volume2 class="size-5 text-accent mb-2" />
							<h3 class="text-sm font-semibold">Kill the noise</h3>
							<p class="text-[11px] text-text-muted mt-1">Keyboard, fans, and background chaos — silenced.</p>
						</div>
						<div class="glass rounded-xl p-4 feature-card">
							<Zap class="size-5 text-accent mb-2" />
							<h3 class="text-sm font-semibold">Zero lag</h3>
							<p class="text-[11px] text-text-muted mt-1">Callouts land the instant you make them.</p>
						</div>
						<div class="glass rounded-xl p-4 feature-card">
							<Monitor class="size-5 text-accent mb-2" />
							<h3 class="text-sm font-semibold">Eyes on the squad</h3>
							<p class="text-[11px] text-text-muted mt-1">Your voice channel sits right on top of your game. Never tab out to see who's talking.</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>


	<!-- ═══════════════════════════════════════════════ -->
	<!-- SECTION: Loot & Levels                         -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="py-24 sm:py-32 px-4 sm:px-6 relative overflow-hidden">
		<!-- Coin rain background -->
		<CoinRain client:visible />

		<div class="mx-auto max-w-6xl relative z-10">
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
				<div class="reveal">
					<span class="section-label">Collect & Level Up</span>
					<h2 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight">
						Showing up<br/><span class="bg-linear-to-r from-yellow-400 via-amber-400 to-yellow-500 bg-clip-text text-transparent">pays off</span>
					</h2>
					<p class="text-text-secondary mt-4 text-base sm:text-lg leading-relaxed max-w-lg">
						Just being in voice levels you up. Collect coins from common all the way to relic and build a stash
						that proves you were there. Hit the top before the year's out to claim that year's coin — because once
						January hits, last year's coins are locked for good.
					</p>

					<div class="mt-8 flex flex-wrap gap-3">
						<div class="glass rounded-xl px-4 py-3 flex items-center gap-2 feature-card">
							<Crown class="size-4 text-yellow-400" />
							<span class="text-sm font-medium">XP & Leveling</span>
						</div>
						<div class="glass rounded-xl px-4 py-3 flex items-center gap-2 feature-card">
							<Star class="size-4 text-amber-400" />
							<span class="text-sm font-medium">Collectible Coins</span>
						</div>
						<div class="glass rounded-xl px-4 py-3 flex items-center gap-2 feature-card">
							<Trophy class="size-4 text-accent-3" />
							<span class="text-sm font-medium">Rarity Tiers</span>
						</div>
						<div class="glass rounded-xl px-4 py-3 flex items-center gap-2 feature-card">
							<Gift class="size-4 text-accent" />
							<span class="text-sm font-medium">Redeem Codes</span>
						</div>
					</div>
				</div>

				<!-- Inventory mockup -->
				<div class="reveal reveal-delay-2 flex justify-center w-full">
					<argon-client-mock view="inventory"></argon-client-mock>
				</div>
			</div>
		</div>
	</section>


	<!-- ═══════════════════════════════════════════════ -->
	<!-- SECTION: More Than Text                        -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="py-24 sm:py-32 px-4 sm:px-6 bg-oled-surface/30">
		<div class="mx-auto max-w-6xl">
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
				<!-- Chat mockup -->
				<div class="reveal order-2 lg:order-1 flex justify-center w-full">
					<argon-client-mock view="chat"></argon-client-mock>
				</div>

				<div class="reveal order-1 lg:order-2">
					<span class="section-label">Messaging</span>
					<h2 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight">
						More than just text
					</h2>
					<p class="text-text-secondary mt-4 text-base sm:text-lg leading-relaxed max-w-lg">
						Bold, spoilers, code blocks, mentions, reactions, GIFs, drag-and-drop files. Reply in threads
						so chat doesn't turn to chaos — and it's all there when you come back, right where you left off.
					</p>

					<div class="mt-6 space-y-3">
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-subtle text-[10px] font-bold text-accent">✓</span>
							<span class="text-sm text-text-secondary"><strong class="text-text-primary">Rich text</strong> — bold, italic, spoilers, code, mentions</span>
						</div>
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-subtle text-[10px] font-bold text-accent">✓</span>
							<span class="text-sm text-text-secondary"><strong class="text-text-primary">File sharing</strong> — up to 8 MB with instant previews</span>
						</div>
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-subtle text-[10px] font-bold text-accent">✓</span>
							<span class="text-sm text-text-secondary"><strong class="text-text-primary">DMs & channels</strong> — text, voice, and announcements</span>
						</div>
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-subtle text-[10px] font-bold text-accent">✓</span>
							<span class="text-sm text-text-secondary"><strong class="text-text-primary">Offline cache</strong> — pick up where you left off</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>


	<!-- ═══════════════════════════════════════════════ -->
	<!-- SECTION: Feature Grid                          -->
	<!-- ═══════════════════════════════════════════════ -->
	<section id="features" class="py-24 sm:py-32 px-4 sm:px-6 bg-oled-surface/30 scroll-mt-16">
		<div class="mx-auto max-w-6xl">
			<div class="reveal text-center mb-12 sm:mb-16">
				<span class="section-label">Everything You Need</span>
				<h2 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight">Everything else, done right</h2>
				<p class="text-text-secondary mt-4 text-base sm:text-lg max-w-2xl mx-auto">
					The boring-but-essential stuff — handled, so your community runs itself.
				</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
				<div class="reveal glass rounded-2xl p-6 feature-card">
					<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-subtle mb-4">
						<Shield class="size-5 text-accent" />
					</div>
					<h3 class="font-semibold mb-2">Roles & Permissions</h3>
					<p class="text-sm text-text-secondary">Roles, ranks, per-channel control. Run it your way, keep the trolls out.</p>
				</div>

				<div class="reveal reveal-delay-1 glass rounded-2xl p-6 feature-card">
					<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-subtle mb-4">
						<Lock class="size-5 text-accent" />
					</div>
					<h3 class="font-semibold mb-2">Security First</h3>
					<p class="text-sm text-text-secondary">Passwordless login, two-factor, full session control. Your account stays yours.</p>
				</div>

				<div class="reveal reveal-delay-2 glass rounded-2xl p-6 feature-card">
					<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-subtle mb-4">
						<Users class="size-5 text-accent" />
					</div>
					<h3 class="font-semibold mb-2">Friends & DMs</h3>
					<p class="text-sm text-text-secondary">Add friends, DM them, jump into a 1:1 call. On or off a server.</p>
				</div>

				<div class="reveal glass rounded-2xl p-6 feature-card">
					<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-subtle mb-4">
						<Sparkles class="size-5 text-accent" />
					</div>
					<h3 class="font-semibold mb-2">Bots & Integrations</h3>
					<p class="text-sm text-text-secondary">Add bots for moderation, music and games — or build your own.</p>
				</div>

				<div class="reveal reveal-delay-1 glass rounded-2xl p-6 feature-card">
					<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-subtle mb-4">
						<Monitor class="size-5 text-accent" />
					</div>
					<h3 class="font-semibold mb-2">Cross-platform</h3>
					<p class="text-sm text-text-secondary">Windows, macOS, Linux. Updates itself, syncs everywhere. (Mobile's coming.)</p>
				</div>

				<div class="reveal reveal-delay-2 glass rounded-2xl p-6 feature-card">
					<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-subtle mb-4">
						<Heart class="size-5 text-accent" />
					</div>
					<h3 class="font-semibold mb-2">Community Driven</h3>
					<p class="text-sm text-text-secondary">Built by people who actually use it. The roadmap's public — shaped by you, not investors.</p>
				</div>
			</div>
		</div>
	</section>


	<!-- ═══════════════════════════════════════════════ -->
	<!-- SECTION: CTA                                   -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="py-24 sm:py-32 px-4 sm:px-6 relative overflow-hidden">
		<!-- Glow bg -->
		<div class="absolute left-1/2 top-1/2 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/5 blur-[120px]"></div>

		<div class="mx-auto max-w-3xl text-center relative z-10">
			<div class="reveal">
				<!-- 3D Text heading -->
				<h2 class="text-3d-wrap">
					<span class="text-3d" data-text="Ready to switch?">Ready to switch?</span>
				</h2>
				<p class="text-text-secondary mt-6 text-base sm:text-lg max-w-xl mx-auto leading-relaxed">
					No paywall on the basics. No ads. No data mining. No investor-driven enshittification.
					Just voice, games, and your people — the way it should be. Free to start, in closed beta now.
				</p>

				<div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
					<button type="button" data-open-enroll class="confetti-trigger w-full sm:w-auto inline-flex items-center justify-center gap-3 rounded-2xl bg-accent px-8 py-4 text-base font-bold text-white transition-all hover:bg-accent-hover hover:shadow-lg hover:shadow-accent/20 hover:-translate-y-0.5 cursor-pointer">
						<Download class="size-5" />
						Request Invite
					</button>
					<a href="https://github.com/argon-chat" target="_blank" rel="noopener" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-2xl border border-oled-border bg-oled-surface/50 px-8 py-4 text-base font-semibold text-text-primary backdrop-blur-sm transition-all hover:border-oled-border hover:bg-oled-hover hover:-translate-y-0.5">
						View on GitHub
						<ArrowRight class="size-4" />
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════ -->
	<!-- ENROLLMENT MODAL                               -->
	<!-- ═══════════════════════════════════════════════ -->
	<div id="enroll-modal" class="enroll-modal-overlay hidden" aria-hidden="true">
		<div class="enroll-modal-backdrop"></div>
		<div class="enroll-modal-container">
			<div class="enroll-modal-card">
				<!-- Close btn -->
				<button type="button" id="enroll-modal-close" class="absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-lg text-text-muted hover:text-text-primary hover:bg-oled-hover transition-colors" aria-label="Close">
					<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
				</button>

				<!-- Success state -->
				<div id="enroll-success" class="hidden text-center py-4">
					<div class="w-14 h-14 rounded-full bg-success/10 border border-success/20 flex items-center justify-center mx-auto mb-5">
						<svg class="size-7 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
					</div>
					<h3 class="text-xl font-black tracking-tight">You're on the list!</h3>
					<p class="text-text-secondary mt-3 text-sm max-w-xs mx-auto">
						We'll send you an invitation email when your spot opens up.
					</p>
					<p class="text-text-muted mt-2 text-xs">Check your inbox (and spam) 😊</p>
				</div>

				<!-- Form state -->
				<div id="enroll-form-wrap">
					<div class="text-center mb-6">
						<div class="w-11 h-11 rounded-xl bg-accent/10 border border-accent/15 flex items-center justify-center mx-auto mb-3">
							<svg class="size-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
						</div>
						<h3 class="text-xl font-black tracking-tight">Request an Invite</h3>
						<p class="text-text-secondary mt-2 text-sm max-w-xs mx-auto">
							Argon's in closed beta. Drop your email and we'll save your spot.
						</p>
						<p class="text-text-muted mt-3 text-xs max-w-xs mx-auto">
							Already received an invitation? Visit the <a href="https://beta.argon.gl" target="_blank" rel="noopener" class="text-accent hover:underline">Beta Portal</a> to access builds.
						</p>
					</div>

					<form id="enroll-form" class="space-y-3">
						<div class="relative">
							<svg class="absolute left-3.5 top-1/2 -translate-y-1/2 size-4 text-text-muted pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
							<input
								type="email"
								id="enroll-email"
								name="email"
								required
								placeholder="you@example.com"
								autocomplete="email"
								class="w-full pl-10 pr-4 py-3 rounded-xl bg-oled-surface border border-oled-border text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent/50 focus:ring-1 focus:ring-accent/25 transition-colors"
							/>
						</div>

						<!-- Cloudflare Turnstile -->
						<div id="turnstile-container" class="flex justify-center"></div>

						<!-- Personal-data consent (required) -->
						<label class="flex items-start gap-2.5 text-left cursor-pointer select-none">
							<input
								type="checkbox"
								id="enroll-consent"
								name="consent"
								required
								class="mt-0.5 size-4 shrink-0 rounded border-oled-border bg-oled-surface accent-accent cursor-pointer"
							/>
							<span class="text-[11px] leading-relaxed text-text-muted">
								I have read and agree to the
								<a href="/terms/" class="text-accent hover:underline">Terms of Service</a>,
								<a href="/privacy/" class="text-accent hover:underline">Privacy Policy</a>, and
								consent to the processing of my personal data as described therein.
							</span>
						</label>

						<!-- Error message -->
						<p id="enroll-error" class="text-red-400 text-sm text-center hidden"></p>

						<button
							type="submit"
							id="enroll-submit"
							class="w-full flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-white hover:bg-accent-hover transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
						>
							<span id="enroll-btn-text">Request Invite</span>
							<svg id="enroll-btn-arrow" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
							<svg id="enroll-btn-spinner" class="size-4 animate-spin hidden" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
						</button>
					</form>

					<p class="text-center text-[10px] text-text-faint mt-3">
						By signing up you agree to our <a href="/terms/" class="underline hover:text-text-muted">Terms</a> & <a href="/privacy/" class="underline hover:text-text-muted">Privacy</a>.
					</p>
				</div>
			</div>
		</div>
	</div>

	<Footer />
</Layout>

