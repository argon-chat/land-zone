---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ChatMockup from '../components/ChatMockup.vue';
import VoiceWaveform from '../components/VoiceWaveform.vue';
import CoinRain from '../components/CoinRain.vue';
import {
  Mic, MicOff, Users, Shield, Monitor, Gamepad2,
  Lock, Zap, ArrowRight, Download, Volume2,
  Headphones, ScreenShare, Sparkles, Heart,
  Crown, Trophy, Gift, Star, Swords
} from 'lucide-astro';
---

<Layout
	title="Argon Chat — Voice, Messaging & Games for Communities"
	description="Argon is a modern communication platform with crystal-clear voice chat, rich messaging, screen sharing, and built-in games. Designed for communities that value quality and privacy. Windows, macOS & Linux."
>
	<Navbar current="/" />

	<!-- ═══════════════════════════════════════════════ -->
	<!-- HERO                                           -->
	<!-- ═══════════════════════════════════════════════ -->
	<section id="main-content" class="relative min-h-[100vh] overflow-hidden flex flex-col">
		<!-- Background -->
		<div class="absolute inset-0 hero-bg-gradient"></div>
		<canvas id="hero-particles" class="absolute inset-0 pointer-events-none z-[1]"></canvas>

		<!-- Hero heading + CTA -->
		<div class="relative z-10 pt-40 sm:pt-48 md:pt-56 pb-10 sm:pb-14 px-4 sm:px-6 text-center">
			<h1 class="hero-title text-4xl font-black leading-[1.05] tracking-tight sm:text-5xl md:text-6xl lg:text-7xl" id="hero-scramble">
				<span class="hero-word" data-word="Talk.">Talk.</span>
				<span class="hero-word" data-word="Play.">Play.</span>
				<span class="hero-word hero-gradient" data-word="Hang out.">Hang out.</span>
			</h1>
			<p class="animate-fade-in-up-delay-1 mx-auto mt-6 max-w-lg text-sm sm:text-base md:text-lg leading-relaxed text-text-secondary">
				Voice, text, screen share and games — all in one place.<br class="hidden sm:block" />
				Built for communities that actually care.
			</p>
			<div class="animate-fade-in-up-delay-2 mt-8 flex flex-wrap items-center justify-center gap-3">
				<button type="button" class="hero-cta-primary group confetti-trigger" data-open-enroll>
					<Download class="size-4" />
					Request Invite
					<span class="hero-cta-shine"></span>
				</button>
			</div>
		</div>

		<!-- Bottom: LIVE APP MOCKUP — the hero IS the product -->
		<div class="relative z-10 flex-1 flex items-end justify-center px-2 sm:px-6 pb-0">
			<div class="hero-app-frame animate-fade-in-up-delay-2">
				<!-- App titlebar -->
				<div class="app-titlebar">
					<div class="flex items-center gap-2">
						<div class="flex gap-1.5">
							<div class="w-3 h-3 rounded-full bg-red-500/70"></div>
							<div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
							<div class="w-3 h-3 rounded-full bg-green-500/70"></div>
						</div>
						<span class="text-[11px] font-medium text-text-muted ml-2">Argon Chat</span>
					</div>
					<div class="flex items-center gap-1.5">
						<div class="app-titlebar-pill">
							<span class="w-1.5 h-1.5 rounded-full bg-green-400 shadow-[0_0_6px_rgba(34,197,94,0.6)]"></span>
							<span class="text-[10px] text-text-muted font-medium" id="hero-online-count">4,218 online</span>
						</div>
					</div>
				</div>

				<!-- App body: sidebar + main -->
				<div class="app-body">
					<!-- Sidebar -->
					<div class="app-sidebar">
						<!-- Server name -->
						<div class="app-server-header">
							<div class="w-8 h-8 rounded-xl bg-accent/15 flex items-center justify-center shrink-0">
								<img src="/argon-cat.svg" alt="Argon" class="size-5" style="filter: brightness(0) invert(0.6) sepia(1) hue-rotate(220deg) saturate(3);" />
							</div>
							<div>
								<div class="text-[11px] font-bold text-text-primary">Argon HQ</div>
								<div class="text-[9px] text-text-muted">128 members</div>
							</div>
						</div>

						<!-- Channels -->
						<div class="app-channels">
							<div class="app-channel-category">TEXT CHANNELS</div>
							<div class="app-channel active">
								<span class="text-text-faint">#</span> general
							</div>
							<div class="app-channel">
								<span class="text-text-faint">#</span> off-topic
							</div>
							<div class="app-channel">
								<span class="text-text-faint">#</span> showcase
							</div>

							<div class="app-channel-category mt-3">VOICE CHANNELS</div>
							<div class="app-channel voice-active">
								<Volume2 class="size-3 text-green-400" />
								<span>Lounge</span>
								<span class="ml-auto text-[9px] text-text-faint">4</span>
							</div>
							<!-- Voice users under channel -->
							<div class="app-voice-users">
								<div class="app-voice-user">
									<img src="/avatars/yuuki.svg" alt="" class="w-5 h-5 rounded-full ring-[1.5px] ring-lime-400/60 shadow-[0_0_8px_rgba(132,255,90,0.3)]" />
									<span class="text-[10px] text-text-secondary">Yuuki</span>
									<div class="flex gap-[2px] ml-auto">
										<div class="voice-bar-mini"></div>
										<div class="voice-bar-mini"></div>
										<div class="voice-bar-mini"></div>
									</div>
								</div>
								<div class="app-voice-user">
									<img src="/avatars/ren.svg" alt="" class="w-5 h-5 rounded-full" />
									<span class="text-[10px] text-text-secondary">Ren</span>
									<Mic class="size-2.5 text-text-faint ml-auto" />
								</div>
								<div class="app-voice-user">
									<img src="/avatars/boba.svg" alt="" class="w-5 h-5 rounded-full" />
									<span class="text-[10px] text-text-secondary">Boba</span>
									<ScreenShare class="size-2.5 text-accent-2 ml-auto" />
								</div>
								<div class="app-voice-user">
									<img src="/avatars/kai.svg" alt="" class="w-5 h-5 rounded-full" />
									<span class="text-[10px] text-text-muted">Kai</span>
									<MicOff class="size-2.5 text-red-400/50 ml-auto" />
								</div>
							</div>
							<div class="app-channel">
								<Volume2 class="size-3 text-text-faint" />
								<span>Gaming</span>
							</div>
						</div>

						<!-- User bar at bottom -->
						<div class="app-user-bar">
							<div class="w-7 h-7 rounded-full bg-accent/20 flex items-center justify-center">
								<span class="text-[9px] font-bold text-accent">Y</span>
							</div>
							<div class="flex-1 min-w-0">
								<div class="text-[10px] font-semibold text-text-primary truncate">You</div>
								<div class="text-[8px] text-green-400">Online</div>
							</div>
							<div class="flex gap-1">
								<div class="w-5 h-5 rounded-md bg-oled-hover flex items-center justify-center">
									<Mic class="size-2.5 text-text-muted" />
								</div>
								<div class="w-5 h-5 rounded-md bg-oled-hover flex items-center justify-center">
									<Headphones class="size-2.5 text-text-muted" />
								</div>
							</div>
						</div>
					</div>

					<!-- Main content area -->
					<div class="app-main">
						<!-- Channel header -->
						<div class="app-main-header">
							<span class="text-text-faint font-medium">#</span>
							<span class="text-[12px] font-semibold text-text-primary">general</span>
							<div class="ml-auto flex items-center gap-2">
								<div class="app-header-pill">
									<Gamepad2 class="size-3 text-accent-3" />
									<span>Pong</span>
								</div>
								<Users class="size-3.5 text-text-muted" />
							</div>
						</div>

						<!-- Messages -->
						<div class="app-messages" id="hero-messages">
							<div class="app-msg" data-delay="0">
								<img src="/avatars/boba.svg" alt="" class="app-msg-avatar-img" />
								<div>
									<div class="app-msg-meta"><span class="app-msg-name" style="color:#c084fc;">Boba</span><span class="app-msg-time">Today at 11:42 PM</span></div>
									<div class="app-msg-text">yo anyone wanna play pong?</div>
								</div>
							</div>
							<div class="app-msg" data-delay="600">
								<img src="/avatars/yuuki.svg" alt="" class="app-msg-avatar-img" />
								<div>
									<div class="app-msg-meta"><span class="app-msg-name" style="color:#a78bfa;">Yuuki</span><span class="app-msg-time">Today at 11:42 PM</span></div>
									<div class="app-msg-text">im in 🎮 join voice</div>
								</div>
							</div>
							<div class="app-msg" data-delay="1200">
								<img src="/avatars/ren.svg" alt="" class="app-msg-avatar-img" />
								<div>
									<div class="app-msg-meta"><span class="app-msg-name" style="color:#22d3ee;">Ren</span><span class="app-msg-time">Today at 11:43 PM</span></div>
									<div class="app-msg-text">lol bet, prepare to lose</div>
								</div>
							</div>
							<div class="app-msg" data-delay="1800">
								<img src="/avatars/kai.svg" alt="" class="app-msg-avatar-img" />
								<div>
									<div class="app-msg-meta"><span class="app-msg-name" style="color:#34d399;">Kai</span><span class="app-msg-time">Today at 11:43 PM</span></div>
									<div class="app-msg-text">nice, just got the <span class="text-amber-400 font-semibold">Year 2026</span> coin btw 🪙</div>
								</div>
							</div>
							<div class="app-msg" data-delay="2400">
								<img src="/avatars/boba.svg" alt="" class="app-msg-avatar-img" />
								<div>
									<div class="app-msg-meta"><span class="app-msg-name" style="color:#c084fc;">Boba</span><span class="app-msg-time">Today at 11:43 PM</span></div>
									<div class="app-msg-text">wait HOW. i'm still level 8 💀</div>
								</div>
							</div>
						</div>

						<!-- Typing indicator + input -->
						<div class="app-input-area">
							<div class="app-typing" id="hero-typing">
								<span class="typing-dot"></span>
								<span class="typing-dot"></span>
								<span class="typing-dot"></span>
								<span class="text-[10px] text-text-muted ml-1"><strong>Yuuki</strong> is typing...</span>
							</div>
							<div class="app-input">
								<span class="text-[11px] text-text-faint">Message #general</span>
								<div class="flex gap-2 ml-auto">
									<Sparkles class="size-3.5 text-text-faint" />
									<Gift class="size-3.5 text-text-faint" />
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Fade out at bottom -->
		<div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-oled-black to-transparent z-20 pointer-events-none"></div>
	</section>


	<!-- ═══════════════════════════════════════════════ -->
	<!-- SECTION: Crystal Clear Voice                   -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="py-24 sm:py-32 px-4 sm:px-6">
		<div class="mx-auto max-w-6xl">
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
				<div class="reveal">
					<span class="section-label">Voice-First</span>
					<h2 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight">
						Crystal clear,<br/>every time
					</h2>
					<p class="text-text-secondary mt-4 text-base sm:text-lg leading-relaxed max-w-lg">
						AI-powered noise suppression, voice isolation, and ultra-low latency audio.
						Whether you're in a team meeting or a late-night gaming session — everyone sounds perfect.
					</p>

					<div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3">
						<div class="glass rounded-xl p-4 feature-card">
							<Volume2 class="size-5 text-accent mb-2" />
							<h3 class="text-sm font-semibold">Noise Suppression</h3>
							<p class="text-[11px] text-text-muted mt-1">DTLN-powered AI removes background noise</p>
						</div>
						<div class="glass rounded-xl p-4 feature-card">
							<Headphones class="size-5 text-accent mb-2" />
							<h3 class="text-sm font-semibold">Voice Isolation</h3>
							<p class="text-[11px] text-text-muted mt-1">Only your voice gets through, nothing else</p>
						</div>
						<div class="glass rounded-xl p-4 feature-card">
							<Zap class="size-5 text-accent mb-2" />
							<h3 class="text-sm font-semibold">Ultra-low Latency</h3>
							<p class="text-[11px] text-text-muted mt-1">WebRTC SFU for real-time audio</p>
						</div>
					</div>
				</div>

				<!-- Voice channel mockup (authentic to client) -->
				<div class="reveal reveal-delay-2 flex justify-center">
					<div class="voice-mockup">
						<!-- Header -->
						<div class="voice-mockup-header">
							<Volume2 class="size-4 text-green-400" />
							<span class="text-sm font-semibold text-text-primary">Lounge</span>
							<span class="text-[10px] text-text-muted ml-auto">3 connected</span>
						</div>

						<!-- Participants -->
						<div class="voice-mockup-body">
							<!-- Yuuki — speaking -->
							<div class="voice-user">
								<img src="/avatars/yuuki.svg" alt="" class="voice-avatar speaking" />
								<div class="flex-1 min-w-0">
									<div class="text-xs font-medium text-text-primary">Yuuki</div>
									<div class="text-[10px] text-lime-400">Speaking</div>
								</div>
								<div class="flex items-center gap-0.5">
									<div class="voice-bar" style="height:8px"></div>
									<div class="voice-bar"></div>
									<div class="voice-bar"></div>
									<div class="voice-bar"></div>
								</div>
							</div>

							<!-- Ren — listening -->
							<div class="voice-user">
								<img src="/avatars/ren.svg" alt="" class="voice-avatar" />
								<div class="flex-1 min-w-0">
									<div class="text-xs font-medium text-text-primary">Ren</div>
									<div class="text-[10px] text-text-muted">Listening</div>
								</div>
								<Mic class="size-3.5 text-text-muted" />
							</div>

							<!-- Boba — screen sharing -->
							<div class="voice-user">
								<img src="/avatars/boba.svg" alt="" class="voice-avatar" />
								<div class="flex-1 min-w-0">
									<div class="text-xs font-medium text-text-primary">Boba</div>
									<div class="text-[10px] text-accent-2">Sharing screen</div>
								</div>
								<ScreenShare class="size-3.5 text-accent-2" />
							</div>

							<!-- Kai — muted -->
							<div class="voice-user">
								<img src="/avatars/kai.svg" alt="" class="voice-avatar" />
								<div class="flex-1 min-w-0">
									<div class="text-xs font-medium text-text-primary">Kai</div>
									<div class="text-[10px] text-text-muted">Muted</div>
								</div>
								<MicOff class="size-3.5 text-red-400/70" />
							</div>
						</div>

						<!-- VU Meter -->
						<div class="voice-mockup-vu">
							<VoiceWaveform client:visible />
						</div>

						<!-- Controls -->
						<div class="voice-controls">
							<button class="voice-ctrl-btn active" aria-label="Microphone">
								<Mic class="size-4" />
							</button>
							<button class="voice-ctrl-btn" aria-label="Headphones">
								<Headphones class="size-4" />
							</button>
							<button class="voice-ctrl-btn" aria-label="Screen share">
								<ScreenShare class="size-4" />
							</button>
							<button class="voice-ctrl-btn danger" aria-label="Disconnect">
								<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M16.5 9.4l-9-5.19M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>


	<!-- ═══════════════════════════════════════════════ -->
	<!-- SECTION: More Than Text                        -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="py-24 sm:py-32 px-4 sm:px-6 bg-oled-surface/30">
		<div class="mx-auto max-w-6xl">
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
				<!-- Chat mockup -->
				<div class="reveal order-2 lg:order-1 flex justify-center">
					<ChatMockup client:visible />
				</div>

				<div class="reveal order-1 lg:order-2">
					<span class="section-label">Messaging</span>
					<h2 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight">
						More than just text
					</h2>
					<p class="text-text-secondary mt-4 text-base sm:text-lg leading-relaxed max-w-lg">
						Rich messages with formatting, mentions, spoilers, file sharing, and emoji.
						Threaded replies keep conversations organized.
					</p>

					<div class="mt-6 space-y-3">
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-subtle text-[10px] font-bold text-accent">✓</span>
							<span class="text-sm text-text-secondary"><strong class="text-text-primary">Rich text</strong> — bold, italic, spoilers, code, mentions</span>
						</div>
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-subtle text-[10px] font-bold text-accent">✓</span>
							<span class="text-sm text-text-secondary"><strong class="text-text-primary">File sharing</strong> — up to 8 MB with instant previews</span>
						</div>
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-subtle text-[10px] font-bold text-accent">✓</span>
							<span class="text-sm text-text-secondary"><strong class="text-text-primary">DMs & channels</strong> — text, voice, and announcements</span>
						</div>
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-subtle text-[10px] font-bold text-accent">✓</span>
							<span class="text-sm text-text-secondary"><strong class="text-text-primary">Offline cache</strong> — pick up where you left off</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>


	<!-- ═══════════════════════════════════════════════ -->
	<!-- SECTION: PlayFrame — Games                     -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="py-24 sm:py-32 px-4 sm:px-6 relative overflow-hidden">
		<div class="mx-auto max-w-6xl">
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
				<div class="reveal">
					<div class="flex items-center gap-2 mb-3">
						<span class="section-label">PlayFrame</span>
						<span class="text-[9px] font-bold uppercase tracking-wider bg-accent/10 text-accent px-2 py-0.5 rounded-full border border-accent/20">Technology</span>
					</div>
					<h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight">
						Games inside<br/>your calls
					</h2>
					<p class="text-text-secondary mt-4 text-base sm:text-lg leading-relaxed max-w-lg">
						PlayFrame is our built-in game platform. Launch multiplayer games directly inside voice channels — no installs, no tab switching. Just play.
					</p>

					<div class="mt-6 space-y-3">
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-3/10 text-[10px] font-bold text-accent-3">⚡</span>
							<span class="text-sm text-text-secondary">P2P Multiplayer</span>
						</div>
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-3/10 text-[10px] font-bold text-accent-3">⚡</span>
							<span class="text-sm text-text-secondary">Sandboxed — games can't access your data</span>
						</div>
						<div class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-3/10 text-[10px] font-bold text-accent-3">⚡</span>
							<span class="text-sm text-text-secondary">Screen share in 4K/60fps alongside games</span>
						</div>
					</div>
				</div>

				<!-- PlayFrame mockup -->
				<div class="reveal reveal-delay-2 flex justify-center">
					<div class="playframe-mockup">
						<div class="playframe-header">
							<Gamepad2 class="size-4 text-accent-3" />
							<span class="text-sm font-semibold text-text-primary">PlayFrame</span>
							<span class="playframe-badge">In Voice</span>
						</div>
						<div class="playframe-grid">
							<!-- Game cards -->
							<div class="playframe-card">
								<div class="playframe-icon" style="background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(139,92,246,0.05));">
									<Swords class="size-8 text-accent" />
								</div>
								<span class="text-sm font-semibold mt-3">Pong</span>
								<span class="text-[10px] text-text-muted">2 players • Classic</span>
								<button class="playframe-play">Play</button>
							</div>
							<div class="playframe-card">
								<div class="playframe-icon" style="background: linear-gradient(135deg, rgba(6,182,212,0.2), rgba(6,182,212,0.05));">
									<Sparkles class="size-8 text-accent-2" />
								</div>
								<span class="text-sm font-semibold mt-3">Snake</span>
								<span class="text-[10px] text-text-muted">Solo • Highscore</span>
								<button class="playframe-play">Play</button>
							</div>
							<div class="playframe-card coming-soon">
								<div class="playframe-icon" style="background: linear-gradient(135deg, rgba(192,132,252,0.1), rgba(192,132,252,0.03));">
									<Gamepad2 class="size-8 text-text-muted" />
								</div>
								<span class="text-sm font-medium text-text-muted mt-3">More soon</span>
