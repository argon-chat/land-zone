---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Shield, Lock, Eye, Server, Key, Globe, ShieldCheck, Database, FileWarning } from 'lucide-astro';
---

<Layout title="Security — Argon Chat" description="How Argon Chat protects your data. Secure infrastructure, encrypted connections, and responsible data practices." image="/og/security.png">
	<Navbar current="/security/" />

	<!-- Hero -->
	<section class="relative z-10 pt-32 sm:pt-40 pb-16 sm:pb-20 px-4 sm:px-6">
		<div class="absolute left-1/2 top-1/4 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/5 blur-[120px]"></div>

		<div class="relative z-10 mx-auto max-w-4xl text-center">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent/20 bg-accent/5 text-accent text-xs font-semibold mb-4">
				<Shield class="size-3.5" />
				Security
			</div>
			<h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight">Your data, your rules</h1>
			<p class="text-text-secondary mt-3 text-sm sm:text-base max-w-xl mx-auto">
				Privacy isn't an afterthought — it's baked into every layer of Argon. Here's how we keep your conversations safe.
			</p>
		</div>
	</section>

	<!-- Principles -->
	<section class="relative z-10 px-4 sm:px-6 pb-20 sm:pb-24">
		<div class="mx-auto max-w-5xl">
			<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
				{[
					{ icon: 'globe', title: 'TLS Everywhere', desc: 'All traffic is encrypted in transit — TLS 1.3 wherever the client supports it, TLS 1.2 as the floor. No plaintext, anywhere.' },
					{ icon: 'server', title: 'Infrastructure Isolation', desc: 'All services run in isolated containers. Production environments are separated from development.' },
					{ icon: 'key', title: 'Token-Based Auth', desc: 'Short-lived JWTs with refresh rotation, so a stolen token stops being useful fast.' },
					{ icon: 'eye', title: 'Secure Credential Storage', desc: 'Passwords are never stored in plaintext. We use industry-standard hashing for all credentials.' },
					{ icon: 'database', title: 'Data Minimization', desc: 'We collect only what\'s needed to run the service. No data mining, no ad profiling.' },
					{ icon: 'lock', title: 'Access Controls', desc: 'Role-based permissions, rate limiting, and audit logging protect against unauthorized access.' },
				].map((item) => (
					<div class="rounded-2xl border border-oled-border bg-oled-surface p-6 hover:border-accent/20 transition-colors">
						<div class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/15 flex items-center justify-center mb-4">
							{item.icon === 'lock' && <Lock class="size-5 text-accent" />}
							{item.icon === 'eye' && <Eye class="size-5 text-accent" />}
							{item.icon === 'server' && <Server class="size-5 text-accent" />}
							{item.icon === 'key' && <Key class="size-5 text-accent" />}
							{item.icon === 'globe' && <Globe class="size-5 text-accent" />}
							{item.icon === 'database' && <Database class="size-5 text-accent" />}
						</div>
						<h3 class="text-sm font-bold text-text-primary mb-1.5">{item.title}</h3>
						<p class="text-xs text-text-secondary leading-relaxed">{item.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- How we handle threats -->
	<section class="relative z-10 px-4 sm:px-6 pb-20 sm:pb-24">
		<div class="mx-auto max-w-5xl">
			<h2 class="text-xl sm:text-2xl font-bold tracking-tight mb-6 flex items-center gap-2">
				<ShieldCheck class="size-5 text-accent" />
				Threat Response
			</h2>

			<div class="max-w-2xl">
				<div class="rounded-2xl border border-oled-border bg-oled-surface p-6">
					<div class="flex items-center gap-3 mb-3">
						<FileWarning class="size-5 text-accent shrink-0" />
						<h3 class="text-sm font-bold text-text-primary">Vulnerability Disclosure</h3>
					</div>
					<p class="text-xs text-text-secondary leading-relaxed mb-3">
						Found a vulnerability? We take security reports seriously and respond within one business day — usually much sooner.
					</p>
					<a href="mailto:security@argon.gl" class="text-xs font-semibold text-accent hover:text-accent-hover transition-colors">
						security@argon.gl →
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Partial open source -->
	<section class="relative z-10 px-4 sm:px-6 pb-20 sm:pb-28">
		<div class="mx-auto max-w-5xl">
			<div class="blur-behind rounded-2xl border border-accent/15 bg-accent/5 p-8 text-center">
				<h2 class="text-lg sm:text-xl font-bold tracking-tight mb-2">Source Available</h2>
				<p class="text-sm text-text-secondary max-w-lg mx-auto mb-5">
					Parts of Argon are published on GitHub so anyone can read the code we ship. It's source-available, not open source — you can inspect it, but the licence doesn't grant open-source rights.
				</p>
				<a href="https://github.com/argon-chat" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-2xl bg-accent px-6 py-3 text-sm font-bold text-white hover:bg-accent-hover hover:shadow-lg hover:shadow-accent/20 transition-all hover:-translate-y-0.5">
					<svg class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
					View on GitHub
				</a>
			</div>
		</div>
	</section>

	<Footer />
</Layout>
