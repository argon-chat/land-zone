---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TermsBody from '../legal/TermsBody.vue';
import { LEGAL_VERSIONS } from '../legal/versions';
---

<Layout title="Terms of Service — Argon Chat" description="Terms of Service for Argon Chat by Argon Incorporated LLC." image="/og/terms.png">
	<Navbar current="/terms/" />

	<section class="pt-32 sm:pt-36 pb-20 sm:pb-28 px-4 sm:px-6">
		<article class="mx-auto max-w-3xl">
			<div class="mb-12 pb-8 border-b border-oled-border-subtle">
				<p class="text-xs font-semibold uppercase tracking-wider text-accent mb-3">Legal</p>
				<h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight">Terms of Service</h1>
				<p class="text-sm text-text-muted mt-3">Last Updated: {LEGAL_VERSIONS.terms}</p>
			</div>

			<TermsBody />
		</article>
	</section>

	<Footer />
</Layout>
