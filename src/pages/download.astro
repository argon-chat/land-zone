---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Shield, ArrowRight } from 'lucide-astro';
---

<Layout title="Download — Argon Chat" description="Argon Chat is in closed beta. Join the enrollment queue." image="/og/download.png">
	<Navbar current="/download/" />

	<section class="relative pt-32 pb-16 sm:pb-24 px-4 sm:px-6 min-h-[70vh] flex items-center justify-center">
		<!-- Background -->
		<div class="absolute left-1/2 top-1/4 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/5 blur-[120px]"></div>

		<div class="relative z-10 mx-auto max-w-lg text-center">
			<div class="w-16 h-16 rounded-2xl bg-accent/10 border border-accent/15 flex items-center justify-center mx-auto mb-6">
				<Shield class="size-8 text-accent" />
			</div>
			<h1 class="animate-fade-in-up text-3xl sm:text-4xl md:text-5xl font-black tracking-tight">
				Closed Beta
			</h1>
			<p class="animate-fade-in-up-delay-1 text-text-secondary mt-4 text-base sm:text-lg max-w-md mx-auto">
				Argon Chat is currently in closed beta. Sign up for enrollment to get early access when your spot opens.
			</p>
			<div class="animate-fade-in-up-delay-2 mt-8">
				<a href="/?enroll=1" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-accent px-8 py-4 text-base font-bold text-white hover:bg-accent-hover hover:shadow-lg hover:shadow-accent/20 transition-all hover:-translate-y-0.5">
					Join Beta Enrollment
					<ArrowRight class="size-4" />
				</a>
			</div>
		</div>
	</section>

	<Footer />
</Layout>
