const primary = [
	{
		name: 'Windows',
		sub: 'Windows 11 · 64-bit',
		icon: 'windows',
		href: 'https://ru-central-updates.argon.gl/ArgonChat_Setup.exe',
		cta: 'Download for Windows',
		ext: '.exe',
	},
	{
		name: 'macOS',
		sub: 'macOS 26+ · Apple Silicon',
		icon: 'apple',
		href: 'https://ru-central-updates.argon.gl/ArgonChat_Setup.dmg',
		cta: 'Download for macOS',
		ext: '.dmg',
	},
];

const others = [
	{ name: 'Linux', sub: 'In the works', icon: 'linux', status: 'Soon' },
	{ name: 'iOS', sub: 'On the roadmap', icon: 'apple', status: 'Planned' },
	{ name: 'Android', sub: 'In the works', icon: 'android', status: 'Soon' },
	{ name: 'SteamOS', sub: 'On the roadmap', icon: 'steam', status: 'Planned' },
	{ name: 'Xbox', sub: 'On the roadmap', icon: 'xbox', status: 'Planned' },
];
---

<Layout title="Download — Argon Chat" description="Download Argon Chat for Windows and macOS. Crystal-clear voice, games inside your calls, and an overlay that keeps you in the game." image="/og/download.png">
	<Navbar current="/download/" />

	<!-- ═══════════════════════════════════════════════ -->
	<!-- HERO                                            -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="dl-hero relative z-10 overflow-hidden pt-36 sm:pt-44 pb-16 px-4 sm:px-6">
		<!-- Ambient glows -->
		<div class="dl-glow dl-glow-1"></div>
		<div class="dl-glow dl-glow-2"></div>
		<div class="dl-grid-overlay"></div>

		<div class="relative z-10 mx-auto max-w-5xl text-center">
			<span class="animate-fade-in-up section-label">Argon Chat · Desktop</span>
			<h1 class="animate-fade-in-up-delay-1 mt-4 text-4xl sm:text-5xl md:text-6xl font-black tracking-tight leading-[1.05]">
				Argon Chat,<br class="hidden sm:block" />
				<span class="dl-accent">right on your desktop</span>
			</h1>
			<p class="animate-fade-in-up-delay-2 mx-auto mt-5 max-w-xl text-base sm:text-lg leading-relaxed text-text-secondary">
				One download. Crystal-clear voice, real games inside your calls, and an overlay
				that keeps you in the game.
			</p>

			<!-- Primary download cards -->
			<div class="animate-fade-in-up-delay-3 mt-12 grid gap-4 sm:grid-cols-2 max-w-2xl mx-auto text-left">
				{primary.map((p) => (
					<a href={p.href} class="dl-card group" data-detect={p.name.toLowerCase()} data-track={`download_${p.name.toLowerCase()}`}>
						<div class="dl-card-glow"></div>
						<div class="relative flex items-center gap-4">
							<div class="dl-icon">
								<svg viewBox="0 0 24 24" fill="currentColor" class="size-7"><path d={glyphs[p.icon]} /></svg>
							</div>
							<div class="min-w-0 flex-1">
								<div class="flex items-center gap-2">
									<h2 class="text-lg font-bold text-text-primary">{p.name}</h2>
									<span class="dl-badge dl-badge-live">
										<span class="dl-dot"></span>Available
									</span>
								</div>
								<p class="text-xs text-text-muted mt-0.5">{p.sub}</p>
							</div>
						</div>
						<div class="relative mt-5 dl-btn">
							{p.cta}
							<span class="dl-btn-ext">{p.ext}</span>
							<ArrowRight class="size-4 transition-transform group-hover:translate-x-1" />
						</div>
					</a>
				))}
			</div>

		</div>
	</section>

	<!-- ═══════════════════════════════════════════════ -->
	<!-- MORE PLATFORMS                                  -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="relative z-10 px-4 sm:px-6 pb-24">
		<div class="mx-auto max-w-5xl">
			<div class="text-center mb-8">
				<h2 class="text-xl sm:text-2xl font-bold tracking-tight">More platforms</h2>
				<p class="text-text-muted text-sm mt-2">We're bringing Argon everywhere your squad hangs out.</p>
			</div>

			<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
				{others.map((o) => (
					<div class={`dl-soon-card ${o.status === 'Soon' ? 'is-soon' : 'is-planned'}`}>
						<div class="dl-soon-icon">
							<svg viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d={glyphs[o.icon]} /></svg>
						</div>
						<h3 class="text-sm font-semibold text-text-primary mt-3">{o.name}</h3>
						<p class="text-[11px] text-text-faint">{o.sub}</p>
						<span class={`dl-status ${o.status === 'Soon' ? 'status-soon' : 'status-planned'}`}>{o.status}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════ -->
	<!-- WHAT YOU GET                                     -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="relative z-10 px-4 sm:px-6 pb-28">
		<div class="mx-auto max-w-3xl">
			<div class="glass rounded-3xl p-8 sm:p-10 relative overflow-hidden">
				<div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-accent/10 blur-[80px]"></div>
				<h2 class="relative text-xl sm:text-2xl font-bold tracking-tight">In the box</h2>
				<div class="relative mt-6 grid sm:grid-cols-2 gap-x-8 gap-y-3.5">
					{[
						'AI noise suppression on every call',
						'PlayFrame — games inside your voice channel',
						'In-game overlay that shows who\'s talking',
						'Coins, levels & loot just for showing up',
						'Passwordless login & full session control',
						'Self-updating — always on the latest build',
					].map((f) => (
						<div class="flex items-start gap-3">
							<span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-accent/12 text-accent">
								<Check class="size-3.5" />
							</span>
							<span class="text-sm text-text-secondary leading-snug">{f}</span>
						</div>
					))}
				</div>
				<div class="relative mt-8 pt-6 border-t border-oled-border flex flex-col sm:flex-row items-center justify-between gap-3">
					<p class="text-xs text-text-muted">Questions before you install?</p>
					<a href="/contact/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent hover:underline">
						Talk to us <ArrowRight class="size-3.5" />
					</a>
				</div>
			</div>
		</div>
	</section>

	<Footer />
</Layout>

<style>
	.dl-hero { min-height: 60svh; }

	/* Was background-clip:text over a gradient with color:transparent, which left
	   the headline invisible wherever the fill does not paint — forced-colors
	   mode most of all. */
	.dl-accent {
		color: var(--color-accent-3);
	}

	html:not(.dark) .dl-accent {
		color: var(--color-accent);
	}

	/* Ambient glows */
	.dl-glow { position: absolute; border-radius: 9999px; filter: blur(120px); pointer-events: none; z-index: 0; }
	.dl-glow-1 { top: -10%; left: 15%; width: 480px; height: 480px; background: rgba(139,92,246,0.14); }
	.dl-glow-2 { top: 10%; right: 10%; width: 380px; height: 380px; background: rgba(6,182,212,0.10); }

	.dl-grid-overlay {
		position: absolute; inset: 0; z-index: 0; pointer-events: none;
		background-image:
			linear-gradient(to right, rgba(139,92,246,0.04) 1px, transparent 1px),
			linear-gradient(to bottom, rgba(139,92,246,0.04) 1px, transparent 1px);
		background-size: 48px 48px;
		mask-image: radial-gradient(ellipse 70% 50% at 50% 0%, #000 30%, transparent 75%);
		-webkit-mask-image: radial-gradient(ellipse 70% 50% at 50% 0%, #000 30%, transparent 75%);
	}

	/* Shared card surface — download cards and platform cards get the exact same
	   translucency, dim and frost, so the cursor trail passing underneath reads
	   the same on both rows. Only geometry differs below. */
	.dl-card,
	.dl-soon-card {
		background: linear-gradient(rgba(255,255,255,0.02), rgba(255,255,255,0.02));
		background-color: rgba(0,0,0,0.55);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid rgba(255,255,255,0.06);
	}
	html:not(.dark) .dl-card,
	html:not(.dark) .dl-soon-card {
		background: linear-gradient(rgba(0,0,0,0.015), rgba(0,0,0,0.015));
		background-color: rgba(255,255,255,0.65);
		border-color: rgba(0,0,0,0.07);
	}

	/* Primary download cards */
	.dl-card {
		position: relative;
		display: block;
		padding: 22px;
		border-radius: 20px;
		overflow: hidden;
		transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), border-color 0.35s, box-shadow 0.35s;
	}
	.dl-card:hover {
		transform: translateY(-4px);
		border-color: rgba(139,92,246,0.4);
		box-shadow: 0 20px 50px rgba(0,0,0,0.4), 0 0 60px rgba(139,92,246,0.12);
	}
	html:not(.dark) .dl-card:hover { box-shadow: 0 20px 50px rgba(0,0,0,0.1), 0 0 50px rgba(139,92,246,0.1); }

	.dl-card-glow {
		position: absolute; top: -40%; left: 50%; transform: translateX(-50%);
		width: 120%; height: 120%;
		background: radial-gradient(ellipse at top, rgba(139,92,246,0.18), transparent 60%);
		opacity: 0; transition: opacity 0.35s; pointer-events: none;
	}
	.dl-card:hover .dl-card-glow { opacity: 1; }

	.dl-icon {
		display: flex; align-items: center; justify-content: center;
		width: 52px; height: 52px; border-radius: 14px;
		background: rgba(139,92,246,0.12);
		border: 1px solid rgba(139,92,246,0.18);
		color: var(--color-text-primary);
		flex-shrink: 0;
		transition: transform 0.35s cubic-bezier(0.16,1,0.3,1);
	}
	.dl-card:hover .dl-icon { transform: scale(1.08) rotate(-4deg); }

	.dl-btn {
		display: flex; align-items: center; justify-content: center; gap: 8px;
		width: 100%; padding: 12px 16px; border-radius: 12px;
		background: var(--color-accent-cta); color: #fff;
		font-size: 14px; font-weight: 700;
		transition: background 0.25s;
	}
	.dl-card:hover .dl-btn { background: var(--color-accent-cta-hover); }
	.dl-btn-ext {
		font-size: 11px; font-weight: 600; opacity: 0.7;
		padding: 2px 7px; border-radius: 6px; background: rgba(255,255,255,0.15);
		margin-left: -2px;
	}

	/* Badges */
	.dl-badge {
		display: inline-flex; align-items: center; gap: 5px;
		font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
		padding: 2px 8px; border-radius: 9999px;
	}
	.dl-badge-live { background: rgba(52,211,153,0.12); color: #34d399; border: 1px solid rgba(52,211,153,0.2); }
	.dl-dot { width: 6px; height: 6px; border-radius: 9999px; background: #34d399; box-shadow: 0 0 0 0 rgba(52,211,153,0.6); animation: dl-pulse 2s infinite; }
	@keyframes dl-pulse {
		0% { box-shadow: 0 0 0 0 rgba(52,211,153,0.5); }
		70% { box-shadow: 0 0 0 6px rgba(52,211,153,0); }
		100% { box-shadow: 0 0 0 0 rgba(52,211,153,0); }
	}

	/* Soon / planned cards */
	.dl-soon-card {
		position: relative;
		display: flex; flex-direction: column; align-items: center; text-align: center;
		padding: 20px 14px;
		border-radius: 16px;
		transition: transform 0.3s, border-color 0.3s, background 0.3s;
	}
	.dl-soon-card:hover { transform: translateY(-3px); border-color: rgba(139,92,246,0.25); }

	.dl-soon-icon {
		display: flex; align-items: center; justify-content: center;
		width: 44px; height: 44px; border-radius: 12px;
		background: rgba(255,255,255,0.04);
		color: var(--color-text-secondary);
		transition: color 0.3s;
	}
	.dl-soon-card:hover .dl-soon-icon { color: var(--color-text-primary); }
	.dl-soon-card.is-soon .dl-soon-icon { color: var(--color-text-primary); }

	.dl-status {
		margin-top: 10px;
		font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
		padding: 3px 10px; border-radius: 9999px;
	}
	.status-soon { background: rgba(251,191,36,0.12); color: #fbbf24; border: 1px solid rgba(251,191,36,0.2); }
	.status-planned { background: rgba(255,255,255,0.05); color: var(--color-text-muted); border: 1px solid rgba(255,255,255,0.08); }
	html:not(.dark) .status-planned { background: rgba(0,0,0,0.04); border-color: rgba(0,0,0,0.08); }

	/* Highlight the card matching the visitor's OS */
	.dl-card.os-match { border-color: rgba(139,92,246,0.45); box-shadow: 0 0 0 1px rgba(139,92,246,0.25), 0 20px 50px rgba(139,92,246,0.12); }

	@media (prefers-reduced-motion: reduce) {
		.dl-dot { animation: none; }
		.dl-card, .dl-soon-card, .dl-icon { transition: none; }
	}
</style>

<script>
	// Surface the download that matches the visitor's OS.
	function highlightOS() {
		const ua = navigator.userAgent.toLowerCase();
		let match: string | null = null;
		if (ua.includes('win')) match = 'windows';
		else if (ua.includes('mac')) match = 'macos';
		if (!match) return;
		const card = document.querySelector(`.dl-card[data-detect="${match}"]`);
		card?.classList.add('os-match');
	}
	highlightOS();
</script>
