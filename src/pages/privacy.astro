---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PrivacyBody from '../legal/PrivacyBody.vue';
import { LEGAL_VERSIONS } from '../legal/versions';
---

<Layout title="Privacy Policy — Argon Chat" description="Privacy Policy for Argon Chat by Argon Incorporated LLC." image="/og/privacy.png">
	<Navbar current="/privacy/" />

	<section class="relative z-10 pt-32 sm:pt-36 pb-20 sm:pb-28 px-4 sm:px-6">
		<article class="mx-auto max-w-3xl">
			<div class="mb-12 pb-8 border-b border-oled-border-subtle">
				<p class="text-xs font-semibold uppercase tracking-wider text-accent mb-3">Legal</p>
				<h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight">Privacy Policy</h1>
				<p class="text-sm text-text-muted mt-3">Effective Date: {LEGAL_VERSIONS.privacy}</p>
				<p class="text-sm text-text-muted mt-1">Entity Responsible: Argon Incorporated LLC</p>
			</div>

			<PrivacyBody />
		</article>
	</section>

	<Footer />
</Layout>
