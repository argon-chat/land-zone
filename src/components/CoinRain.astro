---
// Decorative coin rain behind the "Collect & Level Up" section.
//
// This was a Vue island, which pulled the 73 KB Vue runtime onto the homepage
// for eighteen divs that never change after they are created. The layout is
// picked once at build time instead, so the effect ships as markup and CSS with
// no client JS and no hydration.
//
// The art is the same WebP the in-app mock already uses; the PNG originals were
// 18x the weight for no visible difference at this size.
const COIN_IMAGES = [
	'/coins/staff.webp',
	'/coins/year2026.webp',
	'/coins/contributor.webp',
	'/coins/secret.webp',
];

const coins = Array.from({ length: 18 }, (_, id) => ({
	id,
	x: Math.random() * 100,
	duration: 4 + Math.random() * 5,
	delay: Math.random() * 6,
	size: Math.round(24 + Math.random() * 20),
	img: COIN_IMAGES[Math.floor(Math.random() * COIN_IMAGES.length)],
}));
---

<div class="coin-rain-container" aria-hidden="true">
	{coins.map((coin) => (
		<div
			class="coin"
			style={`left:${coin.x}%;animation-duration:${coin.duration}s;animation-delay:${coin.delay}s;width:${coin.size}px;height:${coin.size}px`}
		>
			<img
				src={coin.img}
				width={coin.size}
				height={coin.size}
				alt=""
				class="coin-img"
				loading="lazy"
				decoding="async"
				draggable="false"
			/>
		</div>
	))}
</div>

<style>
	.coin-rain-container {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.coin {
		position: absolute;
		top: -40px;
		animation: coinFall linear infinite;
		opacity: 0;
	}

	.coin-img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		image-rendering: pixelated;
	}

	/* svh, not vh: on mobile the vh viewport includes the collapsing URL bar, so
	   coins stopped short of the fold as the bar animated. */
	@keyframes coinFall {
		0% {
			transform: translateY(-40px) rotate(0deg);
			opacity: 0;
		}
		5% {
			opacity: 0.7;
		}
		80% {
			opacity: 0.5;
		}
		100% {
			transform: translateY(calc(100svh + 40px)) rotate(720deg);
			opacity: 0;
		}
	}

	/* Eighteen elements falling forever is exactly the ambient motion this
	   preference exists to switch off. */
	@media (prefers-reduced-motion: reduce) {
		.coin-rain-container {
			display: none;
		}
	}
</style>
