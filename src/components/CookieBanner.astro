---

<div class="cookie-banner" id="cookie-banner" role="region" aria-label="Privacy notice">
  <div class="cookie-inner">
    <div class="cookie-icon">🍪</div>
    <div class="cookie-text">
      <p>We use <strong>Cloudflare Web Analytics</strong> and our own <strong>self-hosted Sentry</strong> to understand how the site is used and to catch errors. Privacy-first — no cookies, no session recording, no cross-site tracking, and click metrics are anonymous.</p>
    </div>
    <div class="cookie-actions">
      <button type="button" class="cookie-btn-accept" id="cookie-accept">Got it</button>
      <a href="/privacy/" class="cookie-btn-learn">Learn more</a>
    </div>
  </div>
</div>

<script>
  function initCookieBanner() {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    if (!banner || !acceptBtn) return;

    try {
      if (localStorage.getItem('cookie-consent') === '1') {
        banner.remove();
        return;
      }
    } catch (e) { /* site data blocked; show the notice */ }

    // Show with delay
    setTimeout(() => {
      banner.classList.add('visible');
    }, 1500);

    acceptBtn.addEventListener('click', () => {
      try { localStorage.setItem('cookie-consent', '1'); } catch (e) { /* site data blocked */ }
      banner.classList.remove('visible');
      banner.classList.add('hiding');
      setTimeout(() => banner.remove(), 400);
    });
  }

  initCookieBanner();
</script>
