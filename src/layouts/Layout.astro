---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	/**
	 * Whether this page carries the site's furniture.
	 *
	 * Off for a page that is one decision and nothing else — the invite landing, where the navbar
	 * and footer are links away from the only thing the visitor came to do. What lives here rather
	 * than in the page is the furniture the layout itself draws: the blur strip that exists to sit
	 * under the navbar, and the back-to-top button, both of which are stray marks without it.
	 */
	chrome?: boolean;
}

const {
	title = 'Argon Chat — Voice, Messaging & Games for Communities',
	description = 'Modern communication platform with crystal-clear voice, rich messaging, screen sharing, and built-in games. Designed for communities that value quality and privacy. Windows, macOS & Linux.',
	image = '/og/index.png',
	noindex = false,
	chrome = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
		<meta name="description" content={description} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={new URL(image, Astro.site)} />
		<meta property="og:site_name" content="Argon Chat" />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.site)} />
		<meta name="twitter:site" content="@argonchat" />

		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebApplication",
			"name": "Argon Chat",
			"url": "https://argon.gl",
			"description": description,
			"applicationCategory": "CommunicationApplication",
			"operatingSystem": "Windows, macOS",
			"offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "description": "Free plan — all core features. Optional Ultima subscription adds extras." },
			"author": { "@type": "Organization", "name": "Argon Incorporated LLC", "url": "https://argon.gl" },
			"keywords": "voice chat, messaging app, community platform, screen sharing, gaming communication, voice channels",
			"alternateName": ["Argon", "Argon Voice Chat"]
		})} />

		<!-- Organization entity (logo, social profiles) for knowledge-graph / AI entity resolution -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "Argon Incorporated LLC",
			"alternateName": "Argon Chat",
			"url": "https://argon.gl",
			"logo": "https://argon.gl/argon-cat.svg",
			"foundingDate": "2025",
			"sameAs": ["https://x.com/argonchat", "https://github.com/argon-chat"],
			"address": {
				"@type": "PostalAddress",
				"streetAddress": "2 Sasna Tsrer str.",
				"addressLocality": "Yerevan",
				"postalCode": "0054",
				"addressCountry": "AM"
			},
			"contactPoint": [
				{ "@type": "ContactPoint", "contactType": "customer support", "email": "support@argon.gl" },
				{ "@type": "ContactPoint", "contactType": "security", "email": "security@argon.gl" }
			]
		})} />

		<style>
			/* View Transition for theme toggle */
			::view-transition-old(root),
			::view-transition-new(root) {
				animation: none;
				mix-blend-mode: normal;
			}
		</style>

		<script is:inline>
			(function() {
				var root = document.documentElement;
				// Tells the stylesheet that scripting is live, so the scroll-reveal
				// blocks may start hidden. Without it they stay at rest and visible.
				root.classList.add('js');
				var t = null;
				try { t = localStorage.getItem('theme'); } catch (e) { /* site data blocked */ }
				if (t === 'light') {
					root.classList.remove('dark');
				} else if (t === 'dark') {
					root.classList.add('dark');
				} else if (!window.matchMedia('(prefers-color-scheme: dark)').matches) {
					root.classList.remove('dark');
				}
			})();
		</script>
	</head>
	<body class="min-h-screen overflow-x-hidden flex flex-col">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-accent focus:text-white focus:text-sm focus:font-medium">Skip to content</a>

		<div class="cursor-glow" id="cursor-glow"></div>

		<!-- Sleek line cursor trail -->
		<canvas id="cursor-trail" class="fixed inset-0 -z-10 pointer-events-none"></canvas>

		<!-- Progressive blur under HUD navbar -->
		{chrome && <div class="progressive-blur-nav"></div>}

		<slot />

		<!-- Client-side telemetry: Sentry errors + click metrics -->
		<script>
			import { initAnalytics } from '../lib/analytics';
			initAnalytics();
		</script>

		<CookieBanner />

		<!-- Back to top -->
		{chrome && (
			<button id="back-to-top" type="button" aria-label="Back to top"
				class="fixed bottom-6 right-6 z-40 w-10 h-10 rounded-full bg-oled-elevated border border-oled-border-subtle flex items-center justify-center text-text-muted hover:text-text-primary hover:bg-oled-hover transition-all opacity-0 translate-y-4 pointer-events-none cursor-pointer shadow-lg">
				<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
			</button>
		)}
	</body>
</html>

<script is:inline>
	function initBackToTop() {
		const btn = document.getElementById('back-to-top');
		if (!btn) return;
		let visible = false;
		const toggle = () => {
			const show = window.scrollY > 400;
			if (show !== visible) {
				visible = show;
				btn.classList.toggle('opacity-0', !show);
				btn.classList.toggle('translate-y-4', !show);
				btn.classList.toggle('pointer-events-none', !show);
				btn.classList.toggle('opacity-100', show);
				btn.classList.toggle('translate-y-0', show);
				btn.classList.toggle('pointer-events-auto', show);
			}
		};
		window.addEventListener('scroll', toggle, { passive: true });
		btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
		toggle();
	}

	function initCursorGlow() {
		const glow = document.getElementById('cursor-glow');
		if (!glow) return;
		let raf = 0;
		document.addEventListener('mousemove', (e) => {
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(() => {
				glow.style.left = e.clientX + 'px';
				glow.style.top = e.clientY + 'px';
				glow.style.opacity = '0.15';
			});
		});
		document.addEventListener('mouseleave', () => {
			glow.style.opacity = '0';
		});
	}

	function initReveal() {
		const els = document.querySelectorAll('.reveal');
		if (!els.length) return;
		if (!('IntersectionObserver' in window)) {
			els.forEach(el => el.classList.add('visible'));
			return;
		}
		const obs = new IntersectionObserver((entries) => {
			entries.forEach(e => {
				if (e.isIntersecting) {
					e.target.classList.add('visible');
					obs.unobserve(e.target);
				}
			});
		}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
		els.forEach(el => obs.observe(el));
	}

	// ── Wave cursor trail ──
	function initCursorTrail() {
		const canvas = document.getElementById('cursor-trail');
		if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const E = { friction: 0.5, trails: 20, size: 50, dampening: 0.25, tension: 0.98 };
		let pos = { x: 0, y: 0 };
		let lines = [];
		let running = false;
		let frame = 0;

		// Wave for color cycling
		let wavePhase = Math.random() * 2 * Math.PI;
		const waveFreq = 0.0015;
		const waveAmp = 85;
		const waveOffset = 285;
		function waveUpdate() {
			wavePhase += waveFreq;
			return waveOffset + Math.sin(wavePhase) * waveAmp;
		}

		function createLine(spring) {
			const friction = E.friction + 0.01 * Math.random() - 0.002;
			const s = spring + 0.1 * Math.random() - 0.02;
			const nodes = [];
			for (let i = 0; i < E.size; i++) {
				nodes.push({ x: pos.x, y: pos.y, vx: 0, vy: 0 });
			}
			return { spring: s, friction, nodes };
		}

		function updateLine(line) {
			let e = line.spring;
			let t = line.nodes[0];
			t.vx += (pos.x - t.x) * e;
			t.vy += (pos.y - t.y) * e;
			for (let i = 0; i < line.nodes.length; i++) {
				t = line.nodes[i];
				if (i > 0) {
					const n = line.nodes[i - 1];
					t.vx += (n.x - t.x) * e;
					t.vy += (n.y - t.y) * e;
					t.vx += n.vx * E.dampening;
					t.vy += n.vy * E.dampening;
				}
				t.vx *= line.friction;
				t.vy *= line.friction;
				t.x += t.vx;
				t.y += t.vy;
				e *= E.tension;
			}
		}

		function drawLine(line) {
			let n = line.nodes[0].x;
			let i = line.nodes[0].y;
			ctx.beginPath();
			ctx.moveTo(n, i);
			for (let a = 1, o = line.nodes.length - 2; a < o; a++) {
				const e = line.nodes[a];
				const t = line.nodes[a + 1];
				n = 0.5 * (e.x + t.x);
				i = 0.5 * (e.y + t.y);
				ctx.quadraticCurveTo(e.x, e.y, n, i);
			}
			const e = line.nodes[line.nodes.length - 2];
			const t = line.nodes[line.nodes.length - 1];
			ctx.quadraticCurveTo(e.x, e.y, t.x, t.y);
			ctx.stroke();
			ctx.closePath();
		}

		function createLines() {
			lines = [];
			for (let i = 0; i < E.trails; i++) {
				lines.push(createLine(0.4 + (i / E.trails) * 0.025));
			}
		}

		function render() {
			if (!running) return;
			ctx.globalCompositeOperation = 'source-over';
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			ctx.globalCompositeOperation = 'lighter';
			ctx.strokeStyle = `hsla(${Math.round(waveUpdate())},50%,50%,0.2)`;
			ctx.lineWidth = 1;
			for (let i = 0; i < E.trails; i++) {
				updateLine(lines[i]);
				drawLine(lines[i]);
			}
			frame = window.requestAnimationFrame(render);
		}

		function resize() {
			canvas.width = window.innerWidth - 20;
			canvas.height = window.innerHeight;
		}

		function stop() {
			running = false;
			cancelAnimationFrame(frame);
		}

		function start() {
			if (running || !lines.length) return;
			running = true;
			render();
		}

		function onFirstMove(e) {
			document.removeEventListener('mousemove', onFirstMove);
			document.removeEventListener('touchstart', onFirstMove);
			document.addEventListener('mousemove', updatePos);
			document.addEventListener('touchmove', updatePos);
			updatePos(e);
			createLines();
			start();
		}

		function updatePos(e) {
			if (e.touches) {
				pos.x = e.touches[0].pageX;
				pos.y = e.touches[0].pageY;
			} else {
				pos.x = e.clientX;
				pos.y = e.clientY;
			}
		}

		resize();
		window.addEventListener('resize', resize);
		window.addEventListener('focus', start);
		window.addEventListener('blur', stop);
		document.addEventListener('mousemove', onFirstMove);
		document.addEventListener('touchstart', onFirstMove);
	}

	// Argon Console Branding
	const argonSvg = `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128"><path d="M114.54,88.82c5.35-2.75,9.96-6.72,13.46-11.53c-4.67-3.14-9.86-5.56-15.4-7.09c0.01-24.5-6.29-48.6-18.25-69.73c-7.96,8.45-14.3,18.49-18.62,29.31c-7.66-1.22-15.65-1.06-23.27,0.31C48.13,19.15,41.74,9.02,33.71,0.47C21.76,21.62,15.45,45.7,15.46,70.2c-5.54,1.53-10.73,3.95-15.4,7.09c3.49,4.82,8.1,8.78,13.46,11.53c-3.64,2.85-6.74,6.37-9.14,10.33c5.87,4.32,12.67,7.48,20.05,9.09c19.68,25.4,59.51,25.41,79.2,0c7.38-1.61,14.18-4.78,20.05-9.09C121.28,95.19,118.18,91.68,114.54,88.82z M23.7,68.22c0,0,4.13-2.07,12.4-2.07c8.27,0,19.64,11.37,19.64,11.37s-8.27,6.2-19.64,9.3C32.11,87.91,26.8,77.52,23.7,68.22z M64,98.19c-5.71,0-10.33-4.13-10.33-12.4c1.04-0.35,2.16-0.62,3.3-0.85l3,6.02l1.21-6.61c1.9-0.14,3.84-0.14,5.75,0.01l1.22,6.65l3.01-6.05c1.1,0.23,2.17,0.49,3.18,0.82C74.33,94.05,69.71,98.19,64,98.19z M92.99,86.03c-11.37-3.1-19.63-9.3-19.63-9.3s11.37-11.37,19.63-11.37s12.4,2.07,12.4,2.07C102.29,76.73,96.98,87.12,92.99,86.03z" fill="#3B82F6"/></svg>`)}`;

	console.log(
	  `%c %c %c ARGON %c`,
	  `background: url('${argonSvg}') no-repeat center center / contain; padding: 20px 24px; margin-right: 4px;`,
	  `background: transparent; padding: 0;`,
	  `background: linear-gradient(135deg, #3B82F6, #8B5CF6); color: #fff; font-size: 18px; font-weight: 900; padding: 8px 16px; border-radius: 6px; text-shadow: 0 2px 4px rgba(0,0,0,0.3); letter-spacing: 3px;`,
	  `background: transparent;`
	);

	console.log(
	  `%c🔗 https://argon.gl %c— Made with 💙`,
	  `color: #60A5FA; font-size: 11px; font-weight: bold;`,
	  `color: #94A3B8; font-size: 11px;`
	);

	// Decorative pointer effects (cursor glow + canvas trail) are skipped when the
	// visitor prefers reduced motion, and only run on fine pointers (not touch).
	const allowMotion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches
		&& window.matchMedia('(pointer: fine)').matches;

	initBackToTop();
	initReveal();
	if (allowMotion) { initCursorGlow(); initCursorTrail(); }
</script>